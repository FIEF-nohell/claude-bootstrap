{
  "schema_version": 1,
  "name": "design-studio",
  "version": 5,
  "description": "Eight-role design studio for familiar high-craft product UI with a memorable recurring brand signature and living stack-native design system.",
  "commands": [
    {
      "name": "design-studio",
      "source": "commands/design-studio.md"
    }
  ],
  "agents": [
    "design-studio-creative-director",
    "design-studio-brand-strategist",
    "design-studio-reference-analyst",
    "design-studio-ux-architect",
    "design-studio-ui-designer",
    "design-studio-art-director",
    "design-studio-motion-designer",
    "design-studio-design-systems-engineer"
  ],
  "files": [
    "workflow.md",
    "commands/design-studio.md",
    "agents/creative-director.md",
    "agents/brand-strategist.md",
    "agents/reference-analyst.md",
    "agents/ux-architect.md",
    "agents/ui-designer.md",
    "agents/art-director.md",
    "agents/motion-designer.md",
    "agents/design-systems-engineer.md",
    "references/craft-standards.md"
  ],
  "memory_domains": [
    "brand",
    "product",
    "ui",
    "ux",
    "motion",
    "accessibility",
    "design-system"
  ],
  "install_root": ".claude/modules/design-studio",
  "activation": "explicit-command",
  "source_of_truth": "remote",
  "outputs": {
    "mockup": ".design-studio/mockup/ or project-established prototype location",
    "style_guide": ".docs/design/STYLE_GUIDE.md",
    "tokens": ".docs/design/tokens.json or project-native token source"
  },
  "quality_reference": "references/craft-standards.md"
}
